{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "**/*.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/index.php",
      "permanent": false
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
